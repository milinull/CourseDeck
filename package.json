{
  "name": "course-deck",
  "productName": "CourseDeck",
  "version": "1.0.1",
  "description": "Plataforma local para gerenciar cursos com gamificação e anotações.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build": "electron-builder"
  },
  "keywords": [
    "education",
    "player",
    "gamification",
    "electron",
    "local"
  ],
  "author": "Naka <naka@exemplo.com>",
  "license": "ISC",
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "quill": "^2.0.3"
  },
  "build": {
    "appId": "com.coursedeck.app",
    "productName": "CourseDeck",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "deb",
      "category": "Education",
      "icon": "src/assets/icon.svg"
    },
    "files": [
      "src/**/*",
      "styles/**/*",
      "assets/**/*",
      "js/**/*",
      "*.html",
      "package.json"
    ]
  }
}
